  .hero-image img{ width: 100%; display: block; }
  .cta-row{
    display: flex; gap: 16px; justify-content: center;
    margin-top: 32px; flex-wrap: wrap;
  }

  /* ===== ABOUT ===== */
  .about{ padding: 90px 0; border-bottom: 1px solid var(--line); }
  .about-grid{ display: grid; grid-template-columns: 320px 1fr; gap: 56px; align-items: start; }
  .about-aside{ position: sticky; top: 96px; }
  .about-aside h2{ font-size: 30px; line-height: 1.2; margin-bottom: 24px; }
  .about-cover{ margin: 0; border-radius: 8px; overflow: hidden; box-shadow: 0 18px 44px rgba(0,0,0,0.4); }
  .about-cover img{ width: 100%; display: block; }
  .about-subhead{
    font-size: 21px;
    color: var(--ember-bright);
    margin: 38px 0 14px;
    line-height: 1.3;
  }
