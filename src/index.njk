  }
  .hero-inner{ position: relative; z-index: 2; }
  .hero .eyebrow{ display: block; margin-bottom: 20px; }
  .hero h1{
    font-size: clamp(38px, 6vw, 66px);
    line-height: 1.06;
    color: var(--cream);
